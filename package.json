{
  "name": "shop-stock-zen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run -w backend prisma:generate && node node_modules/vite/bin/vite.js build --root frontend",
    "dev:frontend": "npm run -w frontend dev",
    "dev:backend": "npm run -w backend dev",
    "prisma:generate": "npm run -w backend prisma:generate",
    "prisma:migrate": "npm run -w backend prisma:migrate",
    "prisma:seed": "npm run -w backend prisma:seed"
  },
  "devDependencies": {
    "vite": "^5.4.19"
  }
}