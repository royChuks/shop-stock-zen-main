{
  "name": "shop-stock-zen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run -w backend prisma:generate && npm run -w frontend build",
    "dev:frontend": "npm run -w frontend dev",
    "dev:backend": "npm run -w backend dev",
    "prisma:generate": "npm run -w backend prisma:generate",
    "prisma:migrate": "npm run -w backend prisma:migrate",
    "prisma:seed": "npm run -w backend prisma:seed"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
     "vite": "^5.4.19",
    "effect": "3.18.4",
    "hono": "4.11.4",
    "@prisma/client": "7.3.0",
    "prisma": "7.3.0",
    "@prisma/studio-core": "0.13.1",
    "remeda": "^2.33.4"
  }
}