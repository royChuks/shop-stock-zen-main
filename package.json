{
  "name": "shop-stock-zen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run -w backend prisma:generate && rm -rf frontend/node_modules/vite frontend/node_modules/@vitejs && cd frontend && node ../node_modules/vite/bin/vite.js build",
    "dev:frontend": "npm run -w frontend dev",
    "dev:backend": "npm run -w backend dev",
    "prisma:generate": "npm run -w backend prisma:generate",
    "prisma:migrate": "npm run -w backend prisma:migrate",
    "prisma:seed": "npm run -w backend prisma:seed"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vercel": "^40.0.0",
    "vite": "^5.4.19"
  }
}