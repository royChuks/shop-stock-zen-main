# ──────────────────────────────────────────────
# .vercelignore — Monorepo deployment (frontend + backend + API)
# Unlike .gitignore, this controls which files are uploaded to Vercel.
# We must keep everything needed for build + serverless runtime.
# ──────────────────────────────────────────────

# Dependencies (Vercel installs these via installCommand)
**/node_modules

# Build outputs (regenerated during build)
backend/dist
backend/generated

# Environment files (Vercel dashboard provides env vars)
**/.env
**/.env.example
**/.env.local
**/.env.*.local
**/.env.production

# Git, docs, meta
.git
.gitignore
README.md
DEPLOYMENT.md

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Miscellaneous
.sixth/
